# Configuración de Ambiente
# Copiar este archivo a .env y llenar con valores reales

# IMPORTANTE (TLS): NO usar NODE_TLS_REJECT_UNAUTHORIZED=0, porque desactiva la verificación de certificados.
# Si un proxy o antivirus intercepta el HTTPS y falla con SELF_SIGNED_CERT_IN_CHAIN:
#   - Node 22.15 o superior: definir la variable de entorno de Windows NODE_USE_SYSTEM_CA=1
#     (con setx) y reabrir las terminales.
#   - Node más viejo: usar NODE_EXTRA_CA_CERTS con la ruta al certificado raíz (.pem).
# Ambas se definen en el entorno del sistema o de la terminal, NUNCA en este archivo (.env):
# Node las lee al arrancar, antes de que dotenv cargue el .env.

# Puerto del servidor
PORT=3000
HOST=localhost

# Entorno
NODE_ENV=development

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medex_db
DB_USER=postgres
DB_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXX
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXXXXXXXXXXX

# JWT Secret (para autenticación futura)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=24h

# Email Configuration (para notificaciones)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password

# URLs
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# Gemini (chat de IA para médicos — function calling)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
